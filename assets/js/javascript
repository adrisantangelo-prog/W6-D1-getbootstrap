// Colori ammessi: se arriva un valore diverso, si usa "secondary"
const coloriAmmessi = [
  "primary",
  "secondary",
  "success",
  "danger",
  "warning",
  "info",
  "dark"
];

// Categorie ammesse: un valore diverso non riceve nessun colore speciale
const categorieAmmesse = ["scarpe", "abbigliamento", "accessori"];

// SICUREZZA (anti XSS):
// - l'HTML sta nei <template> di index.html, non in stringhe JavaScript
// - i dati vengono inseriti SOLO con textContent / setAttribute / classList,
//   che li trattano come testo semplice: un eventuale "<script>" nei dati
//   verrebbe mostrato come testo, mai eseguito.

// ===== UTILITÀ =====
// 89 -> "€ 89,00"
function formattaPrezzo(valore) {
  return `€ ${Number(valore).toFixed(2).replace(".", ",")}`;
}

// ===== TEMA CHIARO / SCURO =====
// Bootstrap 5.3 cambia i colori in base all'attributo data-bs-theme su <html>.

const CHIAVE_TEMA = "tema";

// Legge il tema salvato; se non c'è, usa quello del sistema operativo
function leggiTemaIniziale() {
  let salvato = null;
  try {
    salvato = localStorage.getItem(CHIAVE_TEMA);
  } catch (e) {
    // localStorage non disponibile (es. navigazione privata): si ignora
  }
  if (salvato === "light" || salvato === "dark") return salvato;
  return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
}

// Applica il tema alla pagina e aggiorna il testo del bottone
function applicaTema(tema) {
  document.documentElement.setAttribute("data-bs-theme", tema);

  const btn = document.getElementById("btn-tema");
  if (btn) {
    btn.textContent = tema === "dark" ? "☀️ Chiaro" : "🌙 Scuro";
  }
}

// Passa da chiaro a scuro (e viceversa) e salva la scelta
function cambiaTema() {
  const attuale = document.documentElement.getAttribute("data-bs-theme");
  const nuovo = attuale === "dark" ? "light" : "dark";
  applicaTema(nuovo);
  try {
    localStorage.setItem(CHIAVE_TEMA, nuovo);
  } catch (e) {
    // impossibile salvare: il tema vale solo per questa visita
  }
}

// ===== CAROUSEL =====
const slidesContainer = document.getElementById("slides-container");
const tplSlide = document.getElementById("tpl-slide");

function renderSlides() {
  slides.forEach((slide, i) => {
    const copia = tplSlide.content.cloneNode(true);   // copia del modello
    const item = copia.querySelector(".carousel-item");

    if (i === 0) item.classList.add("active");        // solo la prima slide
    const colore = coloriAmmessi.includes(slide.colore) ? slide.colore : "secondary";
    item.classList.add(`bg-${colore}`);

    copia.querySelector(".slide-titolo").textContent = slide.titolo;
    copia.querySelector(".slide-sottotitolo").textContent = slide.sottotitolo;

    slidesContainer.appendChild(copia);
  });
}

// ===== PRODOTTI =====
const prodottiContainer = document.getElementById("prodotti-container");
const modalsContainer = document.getElementById("modals-container");
const tplCard = document.getElementById("tpl-card");
const tplModal = document.getElementById("tpl-modal");

// Somma i prezzi della lista con reduce
function calcolaTotale(lista) {
  return lista.reduce((somma, prodotto) => somma + Number(prodotto.prezzo), 0);
}

// Disegna le card (e i loro modal) per la lista ricevuta
function renderProdotti(lista) {
  // svuota la griglia e i modal del render precedente
  prodottiContainer.replaceChildren();
  modalsContainer.replaceChildren();

  lista.forEach((prodotto) => {
    // l'id del modal usa l'id del prodotto: resta lo stesso anche dopo un filtro
    const id = `prodotto-${prodotto.id}`;
    const prezzo = formattaPrezzo(prodotto.prezzo);
    const categoria = categorieAmmesse.includes(prodotto.categoria) ? prodotto.categoria : "";

    // --- card ---
    const card = tplCard.content.cloneNode(true);
    const img = card.querySelector("img");
    img.setAttribute("src", prodotto.img);
    img.alt = prodotto.nome;
    card.querySelector(".card-prodotto").dataset.categoria = categoria;
    card.querySelector(".badge-categoria").textContent = categoria;
    card.querySelector(".card-title").textContent = prodotto.nome;
    card.querySelector(".prodotto-descrizione").textContent = prodotto.descrizione;
    card.querySelector(".prodotto-prezzo").textContent = prezzo;
    card.querySelector("button").setAttribute("data-bs-target", `#${id}`);
    prodottiContainer.appendChild(card);

    // --- modal collegato alla card ---
    const modal = tplModal.content.cloneNode(true);
    modal.querySelector(".modal").id = id;
    const imgModal = modal.querySelector("img");
    imgModal.setAttribute("src", prodotto.img);
    imgModal.alt = prodotto.nome;
    modal.querySelector(".modal-title").textContent = prodotto.nome;
    modal.querySelector(".prodotto-descrizione").textContent = prodotto.descrizione;
    modal.querySelector(".prodotto-prezzo").textContent = prezzo;
    modalsContainer.appendChild(modal);
  });

  // contatore e totale aggiornati a ogni render
  document.getElementById("contatore").textContent = lista.length;
  document.getElementById("contatore-totale").textContent = prodotti.length;
  document.getElementById("totale").textContent = formattaPrezzo(calcolaTotale(lista));
}

// ===== FILTRI (event delegation) =====
// Un solo listener sul contenitore: funziona per tutti i bottoni, anche futuri
const filtri = document.getElementById("filtri");

filtri.addEventListener("click", function (event) {
  const bottone = event.target.closest("[data-categoria]");
  if (!bottone) return;   // click fuori dai bottoni

  // (a) evidenzia solo il bottone cliccato
  filtri.querySelectorAll(".btn").forEach(b => b.classList.remove("active"));
  bottone.classList.add("active");

  // (b) categoria scelta
  const categoria = bottone.dataset.categoria;

  // (c) lista filtrata
  const filtrati = categoria === "tutti"
    ? prodotti
    : prodotti.filter(p => p.categoria === categoria);

  // (d) ridisegna la griglia
  renderProdotti(filtrati);
});

// ===== INIT: prepara la pagina al caricamento =====
function init() {
  applicaTema(leggiTemaIniziale());
  document.getElementById("btn-tema").addEventListener("click", cambiaTema);

  renderSlides();

  // ordine casuale a ogni caricamento della pagina
  prodotti.sort(() => Math.random() - 0.5);
  renderProdotti(prodotti);
}

init();